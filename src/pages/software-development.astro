---
import Header from "../components/Header.astro";
import Project from "../components/Project.astro";
import Sidebar from "../components/Sidebar.astro";
const projects = [
  {
    title: "Full-Scale E-Commerce Platform — buy.run",
    desc: [
      "Core member of a 2-person team that built a full-featured Amazon-style marketplace from scratch using the MERN stack",
      "Implemented payment gateway integrations (iyzico, PayTR) and cargo provider APIs with robust error handling and webhook support",
      "Built seller dashboards, order management system, product search and filtering with MongoDB aggregation pipelines",
      "Containerized all services with Docker and managed deployments on Linux production servers with Nginx reverse proxy",
      "Designed event-driven communication between services using RabbitMQ and optimized performance with Redis caching"
    ],
    tech: ["Node.js", "TypeScript", "React", "MongoDB", "PostgreSQL", "Redis", "RabbitMQ", "Docker", "Nginx"]
  },
  {
    title: "AI-Powered Call Center Intelligence — Hyperion Energy",
    desc: [
      "Engineered a conversion prediction system in Python by analyzing telephony system documentation and modeling call parameters",
      "Built statistical algorithms that significantly improved lead-to-sale accuracy for the call center team",
      "Reverse-engineered a persistent answering machine detection bug in the telephony system and resolved it, substantially reducing calls lost to voicemail",
      "Developed a full-stack e-learning platform covering curriculum management, video delivery and user progress tracking"
    ],
    tech: ["Python", "Node.js", "TypeScript", "NestJS", "PostgreSQL", "REST API"]
  },
  {
    title: "AI SaaS Products — IdeaScout & AEO Platform",
    desc: [
      "Building IdeaScout: an AI-powered platform that analyzes Reddit, G2 and ProductHunt data using RAG architecture to surface validated business opportunities",
      "Developing an AEO Analytics Platform to help brands monitor and improve their visibility in AI-powered search engines like ChatGPT and Perplexity",
      "Designing full-stack architecture with NestJS backend, Next.js frontend, Chroma vector database and LangChain pipelines",
      "Integrating GPT-4o-mini for intelligent scoring, categorization and insight generation"
    ],
    tech: ["NestJS", "Next.js", "TypeScript", "LangChain", "RAG", "Chroma", "Python", "GPT-4o-mini", "Docker"]
  },
  {
    title: "Freelance Web & E-Commerce Solutions",
    desc: [
      "Developed e-commerce solutions for SMEs including product catalog, cart, checkout flows and admin panels",
      "Integrated payment gateways and cargo provider APIs into client platforms",
      "Built portfolio and corporate websites for small businesses and independent professionals",
      "Delivered data analysis and prediction algorithm projects using Python for demand forecasting and trend analysis"
    ],
    tech: ["Node.js", "React", "TypeScript", "MongoDB", "Python", "REST API", "Docker"]
  }
];
---

<!DOCTYPE html>
<html
>
  <Header title="Software Development | İsa Cansın" />
  <body>
    <div class="content">
        <Sidebar selectedItem="software-development" />
      <nav class="main">
        <div class="container">
          <div class="back-nav-container">
            <a href="/" class="back-nav-button w-inline-block"
              ><img src="/assets/back.svg" loading="lazy" alt="" class="back-nav-img" />
              <div>Back</div></a
            >
          </div>
          <div class="content-container">
            <h1>Software Development</h1>
            <section class="items-container">
                <div class="resouce-items">
                    {projects.map(project => (
                      <Project 
                        title={project.title} 
                        desc={project.desc}
                        tech={project.tech}
                      />
                    ))}
                  </div>
            </section>
          </div>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>