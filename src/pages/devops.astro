---
import Header from '../components/Header.astro';
import Project from "../components/Project.astro";
import Sidebar from "../components/Sidebar.astro";
const projects = [
  {
    title: "Production Server Infrastructure — buy.run",
    desc: [
      "Configured and managed Linux production servers for a large-scale e-commerce platform serving real traffic",
      "Set up Nginx as reverse proxy with SSL termination, request routing and static asset serving",
      "Maintained 99.9% uptime through proactive monitoring, log analysis and rapid incident response",
      "Managed environment configuration, secret management and deployment workflows across staging and production"
    ],
    tech: ["Linux", "Nginx", "Bash", "Server Management", "SSL", "CI/CD"]
  },
  {
    title: "Event-Driven Pipeline Architecture",
    desc: [
      "Designed and implemented asynchronous message queuing with RabbitMQ for decoupled microservice communication",
      "Built Redis caching layers that significantly reduced database load and improved API response times",
      "Containerized all services with Docker for consistent environments across development and production",
      "Implemented CI/CD pipelines with automated testing and deployment to reduce manual release overhead"
    ],
    tech: ["RabbitMQ", "Redis", "Docker", "CI/CD", "GitHub Actions", "Microservices"]
  },
  {
    title: "Cloud Infrastructure Management",
    desc: [
      "Deployed and managed cloud infrastructure across AWS and DigitalOcean for multiple projects",
      "Configured VPS environments, firewall rules, SSH hardening and automated backups",
      "Automated server provisioning and routine operations with Bash scripting",
      "Optimized cloud resource usage to balance performance with cost efficiency"
    ],
    tech: ["AWS", "DigitalOcean", "GCP", "Docker", "Bash", "Linux"]
  }
];
---

<!DOCTYPE html>
<html
>
  <Header title="DevOps & Cloud | İsa Cansın" />
  <body>
    <div class="content">
        <Sidebar selectedItem="devops" />
      <nav class="main">
        <div class="container">
          <div class="back-nav-container">
            <a href="/" class="back-nav-button w-inline-block"
              ><img src="/assets/back.svg" loading="lazy" alt="" class="back-nav-img" />
              <div>Back</div></a
            >
          </div>
          <div class="content-container">
            <h1>DevOps</h1>
            <section class="items-container">
                <div class="resouce-items">
                    {projects.map(project => (
                      <Project 
                        title={project.title} 
                        desc={project.desc}
                        tech={project.tech}
                      />
                    ))}
                  </div>
            </section>
          </div>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>