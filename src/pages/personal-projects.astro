---
import Header from '../components/Header.astro';
import Project from '../components/Project.astro';
import Sidebar from '../components/Sidebar.astro';
const projects = [
  {
    title: "IdeaScout",
    desc: [
      "AI-powered SaaS platform that surfaces validated business opportunities by analyzing Reddit, G2 and ProductHunt data",
      "Built on RAG (Retrieval-Augmented Generation) architecture with LangChain and Chroma vector database",
      "NestJS backend and Next.js frontend with GPT-4o-mini for intelligent idea scoring and categorization",
      "Designed to help founders and product teams identify real user pain points before building"
    ],
    tech: ["NestJS", "Next.js", "LangChain", "RAG", "Chroma", "Python", "GPT-4o-mini"]
  },
  {
    title: "AEO Analytics Platform",
    desc: [
      "Analytics platform that tracks how AI-powered search engines (ChatGPT, Perplexity, Gemini) respond to brand-related queries",
      "Helps brands understand and improve their visibility in the emerging Answer Engine Optimization landscape",
      "Monitors AI-generated responses over time and surfaces actionable content recommendations",
      "Built with NestJS, Next.js and automated AI query pipelines"
    ],
    tech: ["NestJS", "Next.js", "AI Pipelines", "PostgreSQL", "TypeScript"]
  },
  {
    title: "TurkishGo",
    desc: [
      "Duolingo-style progressive language and culture learning SaaS app targeting foreign tourists visiting Turkey",
      "Supports English, Korean and Japanese speaking users with localized content and exercises",
      "AI-powered lessons and conversational practice built with Groq LLM API for fast inference",
      "RAG architecture with LangChain and Chroma for context-aware cultural and linguistic content delivery",
      "MongoDB for user progress tracking, lesson state and personalized learning paths"
    ],
    tech: ["NestJS", "Next.js", "Groq", "LangChain", "RAG", "Chroma", "MongoDB", "TypeScript"]
  }
];
---

<!DOCTYPE html>
<html
>
  <Header title="Personal Projects | İsa Cansın" />
  <body>
    <div class="content">
        <Sidebar selectedItem="personal-projects" />
      <nav class="main">
        <div class="container">
          <div class="back-nav-container">
            <a href="/" class="back-nav-button w-inline-block"
              ><img src="/assets/back.svg" loading="lazy" alt="" class="back-nav-img" />
              <div>Back</div></a
            >
          </div>
          <div class="content-container">
            <h1>Personal Projects</h1>
            <section class="items-container">
                <div class="resouce-items">
                    {projects.map(project => (
                      <Project 
                        title={project.title} 
                        desc={project.desc}
                        tech={project.tech}
                      />
                    ))}
                  </div>
            </section>
          </div>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>