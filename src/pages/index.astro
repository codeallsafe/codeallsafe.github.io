---
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
---


<!DOCTYPE html>
<html
>
  <Header title="İsa Cansın" />
  <body>
    <div class="content">
      <Sidebar selectedItem="home" />
      <nav class="main">
        <div class="container">
          <main class="fold-content-container">
            <div class="fold-content">
              <h1>Hi, I'm İsa.<br />I build things for the web.</h1>
              <p class="lead">
                Passionate and results-driven Full Stack Developer & Software Architect with 6+ years of hands-on experience designing and delivering innovative, scalable, and maintainable solutions across web, mobile, and AI-powered ecosystems. I thrive on turning complex problems into elegant technical architectures that empower businesses to grow efficiently and sustainably.
                <br /><br />
                Specialized in Golang, Node.js, and TypeScript, I architect high-performance microservice-based systems, manage server infrastructures, and optimize cloud deployments across AWS, DigitalOcean, and GCP. My expertise spans backend development, API design, database optimization (MongoDB, PostgreSQL), and CI/CD automation — always with a focus on security, performance, and reliability.
                <br /><br />
                As part of a micro agile team, I also provide technical consulting and end-to-end software support for startups and established companies — helping them scale their systems, improve code quality, and align technical strategies with business goals. Collaboration, precision, and long-term impact are at the heart of every project I build.
                <br /><br />
                Always exploring the intersection of technology and innovation, I'm driven by one mission: to craft systems that make technology invisible and value inevitable.
              </p>
            </div>
            <a href="mailto:codeallsafe@gmail.com" class="button w-button">Contact</a>
          </main>
          <div class="projects-section">
            <!-- Software Development -->
            <a href="/software-development" class="projects-container">
              <div class="single-projects-category">
                <div class="projects-category-image-container">
                  <img src="./assets/browser.svg" loading="lazy" alt="" class="projects-category-image" />
                </div>
              </div>
              <div class="single-projects-content">
                <h4>Software Development</h4>
                <div class="tech-tools-container">
                  <div class="mini-label-white gray-color">Technologies &amp; tools</div>
                  <div class="chips-container chips-container-small-width">
                    <div class="single-chip small-chip">Golang</div>
                    <div class="single-chip small-chip">Node.js</div>
                    <div class="single-chip small-chip">TypeScript</div>
                    <div class="single-chip small-chip">React</div>
                    <div class="single-chip small-chip">Next.js</div>
                    <div class="single-chip small-chip">NestJS</div>
                    <div class="single-chip small-chip">Express.js</div>
                    <div class="single-chip small-chip">MongoDB</div>
                    <div class="single-chip small-chip">PostgreSQL</div>
                    <div class="single-chip small-chip">REST API</div>
                    <div class="single-chip small-chip">GraphQL</div>
                    <div class="single-chip small-chip">Microservices</div>
                  </div>
                </div>
              </div>
            </a>
            <!-- DevOps & Cloud -->
            <a href="/devops" class="projects-container">
              <div class="single-projects-category">
                <div class="projects-category-image-container devops-img">
                  <img src="./assets/database.svg" loading="lazy" alt="" class="projects-category-image" />
                </div>
              </div>
              <div class="single-projects-content">
                <h4>DevOps &amp;&nbsp;Cloud</h4>
                <div class="tech-tools-container">
                  <div class="mini-label-white gray-color">Technologies &amp; tools</div>
                  <div class="chips-container chips-container-small-width">
                    <div class="single-chip small-chip">AWS</div>
                    <div class="single-chip small-chip">DigitalOcean</div>
                    <div class="single-chip small-chip">GCP</div>
                    <div class="single-chip small-chip">Docker</div>
                    <div class="single-chip small-chip">Kubernetes</div>
                    <div class="single-chip small-chip">CI/CD</div>
                    <div class="single-chip small-chip">GitHub Actions</div>
                    <div class="single-chip small-chip">Nginx</div>
                    <div class="single-chip small-chip">Linux</div>
                    <div class="single-chip small-chip">Bash</div>
                    <div class="single-chip small-chip">Monitoring</div>
                    <div class="single-chip small-chip">Redis</div>
                    <div class="single-chip small-chip">RabbitMQ</div>
                  </div>
                </div>
              </div>
            </a>
          </div>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>