---
import { ViewTransitions } from 'astro:transitions';
interface HeaderProps {
  title: string;
}
const { title } = Astro.props as HeaderProps;
---

<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <title>{title}</title>
  <ViewTransitions />
  
  <!-- Meta Description -->
  <meta name="description" content="İsa Cansın - Full Stack Developer & Software Architect with 6+ years of experience in Node.js, TypeScript, and AI-powered application development. Specialized in building scalable microservices, RAG architectures and LangChain-powered SaaS products." />
  
  <!-- Open Graph / Facebook -->
  <meta content={title} property="og:title" />
  <meta content="İsa Cansın - Full Stack Developer & Software Architect with 6+ years of experience in Node.js, TypeScript, and AI-powered application development." property="og:description" />
  <meta content="website" property="og:type" />
  <meta content="/assets/isa-cansin.jpg" property="og:image" />
  
  <!-- Twitter -->
  <meta content="summary_large_image" name="twitter:card" />
  <meta content={title} property="twitter:title" />
  <meta content="İsa Cansın - Full Stack Developer & Software Architect with 6+ years of experience in Node.js, TypeScript, and AI-powered application development." name="twitter:description" />
  <meta content="/assets/isa-cansin.jpg" name="twitter:image" />
  
  <meta content="width=device-width, initial-scale=1" name="viewport" />
  <link href="/assets/styles.css" rel="stylesheet" type="text/css" />
  <link href="https://fonts.googleapis.com/" rel="preconnect" />
  <link href="https://fonts.gstatic.com/" rel="preconnect" crossorigin="anonymous" />
  <!--[if lt IE 9]><script src="https://cdnjs.cloudflare.com/ajax/libs/html5shiv/3.7.3/html5shiv.min.js" type="text/javascript"></script><![endif]-->
  <script type="text/javascript">
    !(function (o, c) {
      var n = c.documentElement,
        t = " w-mod-";
      (n.className += t + "js"), ("ontouchstart" in o || (o.DocumentTouch && c instanceof DocumentTouch)) && (n.className += t + "touch");
    })(window, document);
  </script>
  <link href="/assets/favicon-32x32.png" rel="shortcut icon" type="image/x-icon" />
  <link href="/assets/favicon-32x32.png" rel="apple-touch-icon" />
</head>